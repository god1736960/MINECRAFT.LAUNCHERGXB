{
  "name": "minecraft-launcher-gxb",
  "version": "1.0.0",
  "description": "MINECRAFT.LAUNCHER.GXB - Launcher de Minecraft (Java & Bedrock)",
  "author": "GXB",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "31.3.1",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "skinview3d": "3.1.0",
    "adm-zip": "0.5.12"
  },
  "build": {
    "appId": "com.gxb.minecraftlauncher",
    "productName": "MINECRAFT.LAUNCHER.GXB",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/skinview3d/**/*",
      "node_modules/adm-zip/**/*",
      "node_modules/three/**/*"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MINECRAFT.LAUNCHER.GXB",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
